# Copy this file to `.env` and fill in your values.
# The .env file is ignored by git — never commit it.

ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# ── Beta auth ──────────────────────────────────────────────────────────────
# Format: username:invite_token,username:invite_token,...
# The invite URL for each user is: https://yoursite.com/?invite=<token>
# Tokens can be any random string. Generate one per user:
#   python3 -c "import secrets; print(secrets.token_urlsafe(20))"
#
BETA_USERS=alice:tok_REPLACE_ME,bob:tok_REPLACE_ME

# ── Optional / legacy ─────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=deadlight-2003
LANGSMITH_TRACING=0
MAZE_API_BASE=http://127.0.0.1:8000
